[Unit]
Description=Back up careers.db to Spaces
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
ExecStart=%h/projects/crawlers/backup.sh
# dead-man switch: HEALTHCHECK_BACKUP_URL in .env (unset = no ping)
Environment=HEALTHCHECK_BACKUP_URL=
EnvironmentFile=-%h/projects/crawlers/.env
ExecStopPost=%h/projects/crawlers/hc-ping.sh ${HEALTHCHECK_BACKUP_URL}
