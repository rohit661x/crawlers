# Copy to .env and fill in. Never commit .env.
# Proxy for browser egress. Leave empty for direct.
# Oxylabs residential example: http://customer-USER-cc-ca:PASS@pr.oxylabs.io:7777
PROXY_URL=
# Output root on the droplet; synced to spaces:rohit-base/crawls/
DATA_ROOT=/home/rohit/data/crawls
# Chromium settings
HEADLESS=1
NAV_TIMEOUT_MS=30000
# careers poller
CAREERS_DB=/home/rohit/data/state/careers.db
NOTIFY_TARGET=telegram
# HERMES_BIN=/home/rohit/.local/bin/hermes
# Dead-man switch: pinged after every full run (<url>/fail on a crash or stuck Telegram outbox).
# e.g. a free healthchecks.io check, period 1h, grace 2h, which emails you when pings stop.
HEALTHCHECK_URL=
