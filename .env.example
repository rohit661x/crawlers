# Copy to .env and fill in. Never commit .env.
# Proxy for browser egress. Leave empty for direct.
# Oxylabs residential example: http://customer-USER-cc-ca:PASS@pr.oxylabs.io:7777
PROXY_URL=
# Output root on the droplet; synced to spaces:rohit-base/crawls/
DATA_ROOT=/home/rohit/data/crawls
# Chromium settings
HEADLESS=1
NAV_TIMEOUT_MS=30000
# careers poller
CAREERS_DB=/home/rohit/data/state/careers.db
# Targets: "telegram" = the owner's DM (hermes' TELEGRAM_HOME_CHANNEL), "telegram:<chat_id>" = a chat.
# The bot token comes from ~/.hermes/.env (TELEGRAM_BOT_TOKEN); set it here only to override.
# New-jobs summaries go to every NOTIFY_JOBS_TARGETS destination (comma-separated); alerts, the health
# summary and unit failures go to NOTIFY_OPS_TARGET (the owner). Both fall back to NOTIFY_TARGET.
NOTIFY_TARGET=telegram
# NOTIFY_JOBS_TARGETS=telegram,telegram:-1003936325725
# NOTIFY_OPS_TARGET=telegram
# Dead-man switch: pinged after every full run (<url>/fail on a crash or stuck Telegram outbox).
# e.g. a free healthchecks.io check, period 1h, grace 2h, which emails you when pings stop.
HEALTHCHECK_URL=
# One check each for the systemd jobs (hc-ping.sh; <url>/fail when the unit fails):
# crawl-sync every 15 min (period 15m, grace 30m), crawl-backup daily (period 1d, grace 2h).
HEALTHCHECK_SYNC_URL=
HEALTHCHECK_BACKUP_URL=
